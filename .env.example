# PentraCe ortam degiskenleri. Kopyalayin: cp .env.example .env
# docker compose bu degerleri otomatik okur.

# --- PostgreSQL ---
POSTGRES_USER=pentrace
POSTGRES_PASSWORD=pentrace_secret
POSTGRES_DB=pentrace

# --- Guvenlik (PRODUCTION'da MUTLAKA degistirin) ---
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@pentrace.local
ADMIN_PASSWORD=admin12345

# --- Kimlik dogrulama / uyelik ---
# Acik: login/kayit gerekli. Kapali (masaustu): login yok, otomatik yerel kullanici.
AUTH_ENABLED=true

# --- Plan / abonelik ---
# Acik: Pro tier + gunluk kota + yukseltme. Kapali (masaustu): sinirsiz, Pro yok.
BILLING_ENABLED=true
FREE_DAILY_SCANS=3

# --- Mail dogrulama ---
REQUIRE_EMAIL_VERIFICATION=true
VERIFICATION_CODE_TTL_MINUTES=30
RESEND_COOLDOWN_SECONDS=60

# --- IP abuse engeli ---
MAX_ACCOUNTS_PER_IP=3
ACCOUNT_IP_WINDOW_HOURS=24

# --- SMTP (bos birakilirsa DEV-MOD: kod konsola + dev_mails.log'a yazilir) ---
# Gercek mail icin doldurun (orn. Gmail: smtp.gmail.com / 587 / app-password):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@pentrace.local
SMTP_STARTTLS=true
